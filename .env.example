# Copy to .env.local for local overrides. Both default to the local Django API on port 8000.

# Where the Next.js server reaches the Django API (server side only; never sent to browsers).
# Production: the internal address, e.g. http://web-api:8000/api/v1 (the API lists "web-api" in ALLOWED_HOSTS).
AKINES_API_URL="http://localhost:8000/api/v1"

# Where browsers open the live chat connection (WebSocket). Use wss:// in staging and production,
# e.g. wss://api.akines.com/ws/v1/live. The API's WS_ALLOWED_ORIGINS must list this site's address.
NEXT_PUBLIC_AKINES_LIVE_URL="ws://localhost:8000/ws/v1/live"

# Demo mode: the app runs on sample data in the browser, with no backend (for UI previews, e.g. a Vercel preview).
# Anyone can sign in and nothing is saved to Akines, so never set this on production. Rebuild after changing it.
# NEXT_PUBLIC_DEMO_MODE="1"

# How long the web app's server waits for the API before answering 504 (milliseconds): normal calls, file uploads.
# AKINES_API_TIMEOUT_MS="15000"
# AKINES_API_UPLOAD_TIMEOUT_MS="60000"

# Set by the production image build (Dockerfile): the build then refuses demo mode and a non-wss live address.
# AKINES_ENV="production"
