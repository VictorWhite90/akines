# Copy to .env.local for local overrides. Both default to the local Django API on port 8000.

# Where the Next.js server reaches the Django API (server side only; never sent to browsers).
AKINES_API_URL="http://localhost:8000/api/v1"

# Where browsers open the live chat connection (WebSocket). Use wss:// in staging and production,
# e.g. wss://api.akines.com/ws/v1/live. The API's WS_ALLOWED_ORIGINS must list this site's address.
NEXT_PUBLIC_AKINES_LIVE_URL="ws://localhost:8000/ws/v1/live"
