# Akines API configuration. Copy to backend/.env for local development and fill in.
# Staging and production set these as environment variables. Never commit real values.

# ---- Required everywhere
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/akines
# true only on a developer machine
DEBUG=false

# ---- Required in staging/production
# Long random string: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Shared cache for rate limits and sessions across servers
REDIS_URL=redis://HOST:6379/0
ALLOWED_HOSTS=api.akines.com
CSRF_TRUSTED_ORIGINS=https://akines.com,https://www.akines.com
CORS_ALLOWED_ORIGINS=https://akines.com,https://www.akines.com
# Set to .akines.com when the web app and API are on sibling subdomains; leave empty if the web app proxies /api
COOKIE_DOMAIN=
# How many proxies/load balancers sit in front of the app (1 for a single load balancer)
TRUSTED_PROXY_COUNT=1
# Move the admin away from the default path, e.g. ops-7f3k2/
ADMIN_URL=admin/

# ---- SMS codes (Termii). Required for phone sign-in outside local development.
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=Akines
TERMII_CHANNEL=dnd

# ---- Email codes and security notices. Required for email sign-in outside local development.
DEFAULT_FROM_EMAIL=Akines <no-reply@akines.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# ---- Bot protection on sign-in (Cloudflare Turnstile). Recommended in production.
TURNSTILE_SECRET_KEY=

# ---- Policy (defaults shown)
MIN_SIGNUP_AGE=18
TERMS_VERSION=2026-10-26
PHONE_DEFAULT_REGION=NG
PHONE_ALLOWED_REGIONS=NG
# Platform-wide SMS ceiling per day; protects the SMS budget from fraud
SMS_DAILY_CAP=5000
COMMUNITY_MAX_PER_USER=5

# ---- Optional
# Serve OpenAPI docs at /api/v1/docs/ (on by default when DEBUG=true)
API_DOCS=false
LOG_LEVEL=INFO
