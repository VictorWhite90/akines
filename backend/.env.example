# Copy to backend/.env and fill in. Never commit backend/.env.
# Local dev with Postgres.app: DATABASE_URL=postgresql://<mac-username>@localhost:5432/akines
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/akines
# Long random string in staging/production (python -c "import secrets;print(secrets.token_urlsafe(50))")
SECRET_KEY=
# true only on your own machine
DEBUG=false
# Comma-separated
ALLOWED_HOSTS=api.akines.com
CSRF_TRUSTED_ORIGINS=https://akines.com
CORS_ALLOWED_ORIGINS=https://akines.com
