# Copy to backend/.env and fill in. Never commit backend/.env.
# Local dev with Postgres.app: DATABASE_URL=postgresql://<mac-username>@localhost:5432/akines
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/akines
# Long random string in staging/production (python -c "import secrets;print(secrets.token_urlsafe(50))")
SECRET_KEY=
# true only on your own machine
DEBUG=false
# Comma-separated
ALLOWED_HOSTS=api.akines.com
CSRF_TRUSTED_ORIGINS=https://akines.com
CORS_ALLOWED_ORIGINS=https://akines.com

# SMS sign-in codes (Termii). Leave TERMII_API_KEY empty locally: codes print in the terminal.
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=Akines
TERMII_CHANNEL=dnd
# Email sign-in codes. Leave EMAIL_HOST empty locally: emails print in the terminal.
DEFAULT_FROM_EMAIL=Akines <no-reply@akines.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
